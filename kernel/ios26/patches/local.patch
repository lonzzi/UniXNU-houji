+	struct user64_dyld_image_info image;
+	user_addr_t dyld_info = task_get_all_image_info_addr(task);
+	if (plausible_user_address(dyld_info) && copyin(dyld_info, &infos, sizeof(infos)) == 0 &&
+	    infos.infoArrayCount && plausible_user_address(infos.infoArray) &&
+	    copyin(infos.infoArray, &image, sizeof(image)) == 0) {
+		houji26_display_fault.image0 = image.imageLoadAddress;
+	}
+	uint64_t fp = get_saved_state_fp(state), frame[2];
+	for (unsigned i = 0; i < sizeof(houji26_display_fault.frames) / sizeof(uint64_t) &&
+	    plausible_user_address(fp) && (fp & 7) == 0; ++i) {
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
