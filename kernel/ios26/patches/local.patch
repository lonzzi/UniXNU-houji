+	houji26_display_fault.pid = proc_pid(proc);
+	houji26_display_fault.code[0] = count > 0 ? code[0] : 0;
+	houji26_display_fault.code[1] = count > 1 ? code[1] : 0;
+	houji26_display_fault.pc = get_saved_state_pc(state);
+	houji26_display_fault.lr = get_saved_state_lr(state);
+	houji26_display_fault.far = get_saved_state_far(state);
+	houji26_display_fault.esr = get_saved_state_esr(state);
+	vm_shared_region_t region = vm_shared_region_get(task);
+	if (region) {
+		houji26_display_fault.slide = region->sr_slide;
+		vm_shared_region_deallocate(region);
+	}
