+unsigned
+houji26_wallpaper_snapshot(char *out, unsigned capacity)
+{
+	static const char prefix[] = "redwood26: ";
+	static const char *const phases[] = {
+		"loaded into SpringBoard (pid ",
+		"loaded into PosterBoard (pid ",
+		"SpringBoard: no PRSService",
+		"SpringBoard: PosterBoard: prewarm asked",
+		"SpringBoard: PosterBoard: prewarm answered",
+		"SpringBoard: the default wallpaper: asking",
+		"SpringBoard: the default wallpaper asked for",
+		"SpringBoard: no +[SBSUIWallpaperService",
+		"PosterBoard: no data store after 30 s",
+		"PosterBoard: build data store",
+		"PosterBoard: ExtensionKit matched ",
+		"PosterBoard: provider inventory: ",
+		"Metal render pipeline refusal: ",
+		"PosterBoard: role PRPosterRoleLockScreen:",
+		"PosterBoard: role PRPosterRoleHomeScreen:",
+		"PosterBoard: the incoming poster:",
+		"PosterBoard: error ",
+		"PosterBoard: general error ",
+		"PosterBoard: known extension ",
+	};
+	struct { const char *text; size_t length; } lines[sizeof(phases) / sizeof(phases[0])] = {};
+	static const char header[] = "HOUJI26 WALLPAPER: retained setup messages\n";
+	int enabled = 0;
+	if (capacity < sizeof(header) ||
+	    !PE_parse_boot_argn("houji_wallpaper_diag", &enabled, sizeof(enabled)) || enabled != 1) {
+		return 0;
+	}
+
+	/* Read the immutable prefix length under the existing writer lock.
+	 * Restore the local interrupt state before scanning the prefix. */
+	uint64_t daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", DAIFSC_IRQF | DAIFSC_FIQF);
+	bool locked = false;
+	for (unsigned attempt = 0; !locked && attempt < 256; attempt++) {
+		locked = os_atomic_cmpxchg(&loader_log_lock, 0, 1, acquire);
+	}
+	uint32_t end = 0;
+	if (locked) {
+		end = MIN(loader_keep_len, sizeof(loader_keep));
+		os_atomic_store(&loader_log_lock, 0, release);
+	}
+	__builtin_arm_wsr64("DAIF", daif);
+	if (!locked) {
+		return 0;
+	}
+
+	for (const char *p = loader_keep; p < loader_keep + end;) {
+		const char *eol = p;
+		while (eol < loader_keep + end && *eol != '\n') {
+			eol++;
+		}
+		if (eol == loader_keep + end) {
+			break;
+		}
+		size_t length = (size_t)(eol - p);
+		if (length >= sizeof(prefix) - 1 && memcmp(p, prefix, sizeof(prefix) - 1) == 0) {
+			const char *message = p + sizeof(prefix) - 1;
+			for (unsigned phase = 0; phase < sizeof(phases) / sizeof(phases[0]); phase++) {
+				size_t n = strlen(phases[phase]);
+				if ((size_t)(eol - message) >= n && memcmp(message, phases[phase], n) == 0) {
+					lines[phase].text = p;
+					lines[phase].length = MIN(length, 160U);
+					break;
+				}
+			}
+		}
+		p = eol + 1;
+	}
+
+	unsigned used = sizeof(header) - 1;
+	memcpy(out, header, used);
+	for (unsigned phase = 0; phase < sizeof(phases) / sizeof(phases[0]); phase++) {
+		size_t n = lines[phase].length;
+		if (n == 0 || n + 1 > capacity - used) {
+			continue;
+		}
+		memcpy(out + used, lines[phase].text, n);
+		out[used + n] = '\n';
+		used += (unsigned)n + 1;
+	}
+	return used;
+}
