+static int
+mdevrw_ops(struct mdev *md, struct uio *uio)
+{
+	const size_t bounce_bytes = 64 * 1024;
+	void *bounce = kalloc_data(bounce_bytes, Z_WAITOK);
+	int error = 0;
+	if (bounce == NULL) {
+		return ENOMEM;
+	}
+	while (uio_resid(uio) > 0) {
+		uint64_t offset = (uint64_t)uio->uio_offset;
+		int count = (int)mdev_transfer_bytes(mdev_bytes_from_pages(md->mdSize),
+		    offset, (uint64_t)uio_resid(uio), bounce_bytes);
+		if (count == 0) {
+			break;
+		}
+		if (uio->uio_rw == UIO_READ) {
+			error = md->mdOps->transfer(md->mdContext, offset, bounce, (size_t)count, 0);
+			if (!error) {
+				error = uiomove64((addr64_t)(uintptr_t)bounce, count, uio);
+			}
+		} else if (uio->uio_rw == UIO_WRITE) {
+			error = uiomove64((addr64_t)(uintptr_t)bounce, count, uio);
+			if (!error) {
+				error = md->mdOps->transfer(md->mdContext, offset, bounce, (size_t)count, 1);
+			}
+		} else {
+			error = EINVAL;
+		}
+		if (error) {
+			break;
+		}
+	}
+	kfree_data(bounce, bounce_bytes);
+	return error;
+}
